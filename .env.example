# Copy to .env and fill in. Never commit your real .env file.
# Free key (no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: models tried in order (falls back if one is retired, rate-limited or overloaded)
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Optional tuning
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=30
AI_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
